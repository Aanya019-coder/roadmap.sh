---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import AuthForms from '../components/auth/AuthForms';
---

<BaseLayout title="Login" description="Sign in to your roadmap.sh account to track progress, projects, and sync across devices.">
  <Navbar client:load />

  <main class="min-h-[calc(100vh-250px)] flex items-center justify-center py-12 px-4">
    <AuthForms client:load initialMode="login" />
  </main>

  <Footer />
</BaseLayout>
