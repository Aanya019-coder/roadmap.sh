---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button';
import Avatar from '../../components/ui/Avatar';
import Card from '../../components/ui/Card';
---

<BaseLayout title="Account Settings" description="Manage your roadmap.sh profile settings, email notifications, and security.">
  <Navbar client:load />

  <main class="max-w-[1000px] mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-white mb-8">Settings</h1>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {/* Sidebar Links */}
      <div class="space-y-1">
        <button class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold bg-bg-secondary text-white border-l-2 border-accent-yellow">
          Profile Settings
        </button>
        <button class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-text-secondary hover:text-white hover:bg-bg-secondary/40 transition-all">
          Account Security
        </button>
        <button class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-text-secondary hover:text-white hover:bg-bg-secondary/40 transition-all">
          Notifications
        </button>
      </div>

      {/* Settings Form */}
      <div class="md:col-span-3 bg-bg-secondary border border-border-default rounded-xl p-8 space-y-8">
        <div>
          <h2 class="text-lg font-bold text-white mb-2">Public Profile</h2>
          <p class="text-xs text-text-secondary">This information will be displayed publicly on your profile page.</p>
        </div>

        <div class="flex items-center gap-6">
          <Avatar size="lg" name="Guest Developer" />
          <div>
            <Button variant="outline" size="sm">Change Avatar</Button>
            <p class="text-[10px] text-text-muted mt-2">JPG or PNG. Max size 800KB.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">
              Full Name
            </label>
            <input 
              type="text" 
              value="Guest Developer" 
              className="w-full bg-bg-tertiary/50 border border-border-default rounded-md px-3.5 py-2 text-sm text-white focus:outline-none focus:border-border-hover transition-colors"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">
              Username
            </label>
            <input 
              type="text" 
              value="guest" 
              className="w-full bg-bg-tertiary/50 border border-border-default rounded-md px-3.5 py-2 text-sm text-white focus:outline-none focus:border-border-hover transition-colors"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">
            Bio
          </label>
          <textarea 
            rows="3" 
            className="w-full bg-bg-tertiary/50 border border-border-default rounded-md px-3.5 py-2 text-sm text-white focus:outline-none focus:border-border-hover transition-colors resize-none"
            placeholder="Tell us about yourself..."
          >New to roadmap.sh! Learning something new every day.</textarea>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-border-default">
          <Button variant="outline" size="sm">Cancel</Button>
          <Button variant="primary" size="sm">Save Changes</Button>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
