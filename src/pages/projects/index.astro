---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge';
import Card from '../../components/ui/Card';
import CommunityStats from '../../components/home/CommunityStats.astro';

// Dynamically load all project JSON files
const projectFiles = import.meta.glob('../../data/projects/*.json', { eager: true });
const projects = Object.values(projectFiles).map((file: any) => file.default);

const categories = ['All', 'Frontend', 'Backend', 'DevOps'];
---

<BaseLayout title="Project Ideas" description="Browse and build community-curated project ideas across Frontend, Backend, and DevOps to level up your engineering skills.">
  <Navbar client:load />

  <main class="max-w-[1280px] mx-auto px-4 py-12">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-white mb-4">Project Ideas</h1>
      <p class="text-text-secondary text-base max-w-xl mx-auto">
        Practical, real-world project ideas that you can build to improve your coding skills. Complete them to build a stunning portfolio.
      </p>
    </div>

    {/* Filter tabs */}
    <div class="flex items-center justify-center gap-2 border-b border-border-default mb-10 overflow-x-auto pb-2 scrollbar-thin">
      {categories.map((category) => (
        <button
          class="px-4 py-2 text-sm font-semibold rounded-md transition-all text-text-secondary hover:text-white"
          data-category={category}
          id={`tab-${category.toLowerCase()}`}
        >
          {category}
        </button>
      ))}
    </div>

    {/* Projects Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
      {projects.map((project) => (
        <div class="project-card block" data-project-category={project.category}>
          <Card className="h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <Badge variant={project.difficulty === 'beginner' ? 'beginner' : 'intermediate'}>
                  {project.difficulty}
                </Badge>
                <span class="text-xs text-text-muted font-semibold uppercase tracking-wider">{project.category}</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{project.title}</h3>
              <p class="text-xs text-text-secondary line-clamp-3 mb-6">{project.description}</p>
            </div>
            <div class="flex items-center justify-between border-t border-border-default/40 pt-4">
              <span class="text-[11px] text-text-muted font-medium">1.2K Started</span>
              <a 
                href={`/projects/${project.id}`}
                class="text-xs font-semibold text-accent-yellow hover:text-yellow-300 transition-colors"
              >
                View Project →
              </a>
            </div>
          </Card>
        </div>
      ))}
    </div>
  </main>

  <CommunityStats />
  <Footer />

  {/* Client-side filter script */}
  <script is:inline>
    const tabs = document.querySelectorAll('[data-category]');
    const cards = document.querySelectorAll('.project-card');

    // Set 'All' tab active initially
    const allTab = document.getElementById('tab-all');
    if (allTab) allTab.classList.add('bg-bg-tertiary', 'text-white');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Reset active tabs
        tabs.forEach(t => t.classList.remove('bg-bg-tertiary', 'text-white'));
        tab.classList.add('bg-bg-tertiary', 'text-white');

        const filter = tab.getAttribute('data-category');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-project-category');
          if (filter === 'All' || cardCat === filter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
