---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import RoadmapTabs from '../../components/roadmap/RoadmapTabs';
import Badge from '../../components/ui/Badge';
import Card from '../../components/ui/Card';
import CommunityStats from '../../components/home/CommunityStats.astro';

export async function getStaticPaths() {
  const roleSlugs = [
    'frontend', 'backend', 'full-stack', 'devops', 'devsecops', 'data-analyst', 
    'ai-engineer', 'ai-data-scientist', 'data-engineer', 'android', 'machine-learning', 
    'postgresql', 'ios', 'blockchain', 'qa', 'software-architect', 'cyber-security', 
    'ux-design', 'technical-writer', 'game-developer', 'server-side-game-developer', 
    'mlops', 'product-manager', 'engineering-manager', 'developer-relations', 
    'bi-analyst', 'network-engineer'
  ];

  const skillSlugs = [
    'sql', 'computer-science', 'react', 'vue', 'angular', 'javascript', 'typescript', 
    'nodejs', 'python', 'system-design', 'java', 'aspnet-core', 'api-design', 
    'spring-boot', 'flutter', 'cpp', 'rust', 'golang', 'software-design-architecture', 
    'graphql', 'react-native', 'design-system', 'prompt-engineering', 'mongodb', 
    'linux', 'kubernetes', 'docker', 'aws', 'terraform', 'datastructures-and-algorithms', 
    'redis', 'git-github', 'php', 'cloudflare', 'ai-red-teaming', 'ai-agents', 'nextjs', 
    'code-review', 'kotlin', 'html', 'css', 'swift', 'shell', 'laravel', 'elasticsearch', 
    'wordpress', 'django', 'ruby', 'ruby-on-rails', 'claude-code', 'vibe-coding', 
    'scala', 'leetcode'
  ];

  const bestPracticesSlugs = [
    'aws-best-practices', 'api-security-best-practices', 
    'backend-performance-best-practices', 'frontend-performance-best-practices', 
    'code-review-best-practices'
  ];

  const allSlugs = [...roleSlugs, ...skillSlugs, ...bestPracticesSlugs];

  return allSlugs.map(slug => ({
    params: { roadmap: slug }
  }));
}

const { roadmap } = Astro.params;

const formatTitle = (slug: string) => {
  if (slug === 'cpp') return 'C++';
  if (slug === 'git-github') return 'Git & GitHub';
  if (slug === 'nodejs') return 'Node.js';
  if (slug === 'nextjs') return 'Next.js';
  return slug
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

const title = formatTitle(roadmap);

// Dynamically load all project JSON files
const projectFiles = import.meta.glob('../../data/projects/*.json', { eager: true });
const allProjects = Object.values(projectFiles).map((file: any) => file.default);

// Filter projects matching this roadmap's category or fall back
let categoryMatch = 'Frontend';
if (roadmap.includes('backend') || roadmap.includes('sql') || roadmap.includes('postgresql') || roadmap.includes('nodejs') || roadmap.includes('golang') || roadmap.includes('python')) {
  categoryMatch = 'Backend';
} else if (roadmap.includes('devops') || roadmap.includes('docker') || roadmap.includes('kubernetes') || roadmap.includes('aws') || roadmap.includes('terraform')) {
  categoryMatch = 'DevOps';
}

const filteredProjects = allProjects.filter(p => p.category === categoryMatch);
const displayProjects = filteredProjects.length > 0 ? filteredProjects : allProjects;
---

<BaseLayout title={`${title} Projects`} description={`Practice your ${title} skills by building curated project ideas.`}>
  <Navbar client:load />

  <main class="max-w-[1280px] mx-auto px-4 py-6">
    {/* Breadcrumbs */}
    <div class="py-3">
      <a href={`/${roadmap}`} class="text-xs text-text-muted hover:text-text-secondary transition-colors">
        ← Back to {title} Roadmap
      </a>
    </div>

    {/* Header */}
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-white mb-2">{title} Projects</h1>
      <p class="text-text-secondary text-sm">Practice your knowledge by building these hands-on project ideas.</p>
    </div>

    {/* Tabs */}
    <div class="mb-8">
      <RoadmapTabs client:load roadmapId={roadmap} activeTab="projects" />
    </div>

    {/* Projects Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayProjects.map((project) => (
        <Card className="h-full flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <Badge variant={project.difficulty === 'beginner' ? 'beginner' : 'intermediate'}>
                {project.difficulty}
              </Badge>
              <span class="text-xs text-text-muted font-semibold uppercase tracking-wider">{project.category}</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{project.title}</h3>
            <p class="text-xs text-text-secondary line-clamp-3 mb-6">{project.description}</p>
          </div>
          <div class="flex items-center justify-between border-t border-border-default/40 pt-4">
            <span class="text-[11px] text-text-muted font-medium">1.2K Started</span>
            <a 
              href={`/projects/${project.id}`}
              class="text-xs font-semibold text-accent-yellow hover:text-yellow-300 transition-colors"
            >
              View Project →
            </a>
          </div>
        </Card>
      ))}
    </div>
  </main>

  <CommunityStats />
  <Footer />
</BaseLayout>
