---

<BaseLayout title="Developer Roadmaps">
  <Navbar client:load />
  
  <main>
    <!-- Hero Section -->
    <section class="py-16 md:py-24 text-center">
      <div class="max-w-[1280px] mx-auto px-4">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
          Developer Roadmaps
        </h1>
        <p class="text-text-secondary text-base md:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
          roadmap.sh is a community effort to create roadmaps, guides and other educational content to help guide developers in picking up a path and guide their learnings.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/signup" class="px-6 py-3 bg-accent-yellow text-gray-900 font-medium rounded-md hover:bg-yellow-300 transition-colors text-sm">
            Subscribe for updates
          </a>
          <a href="/roadmaps" class="px-6 py-3 border border-border-default text-white font-medium rounded-md hover:border-border-hover hover:bg-bg-tertiary transition-all text-sm">
            Explore Roadmaps
          </a>
        </div>
      </div>
    </section>

    <!-- Role-based Roadmaps -->
    <section class="py-12">
      <div class="max-w-[1280px] mx-auto px-4">
        <p class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-2">Community created roadmaps</p>
        <h2 class="text-2xl font-bold text-white mb-8">Role-based Roadmaps</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {roleRoadmaps.map((roadmap) => (
            <a 
              href={`/${roadmap.slug}`}
              class="group flex items-start gap-3 p-4 rounded-lg bg-bg-secondary border border-border-default hover:border-border-hover transition-all duration-200 hover:-translate-y-0.5"
            >
              <span class="text-xl flex-shrink-0 mt-0.5">{roadmap.icon}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-white group-hover:text-accent-yellow transition-colors">{roadmap.title}</span>
                  <span class="text-text-muted group-hover:text-text-secondary transition-colors">→</span>
                </div>
                <p class="text-xs text-text-muted mt-1 line-clamp-1">{roadmap.desc}</p>
              </div>
            </a>
          ))}
          <!-- Create your own -->
          <a 
            href="/roadmaps"
            class="group flex items-center justify-center gap-2 p-4 rounded-lg border-2 border-dashed border-border-default hover:border-border-hover transition-all duration-200"
          >
            <span class="text-2xl text-text-muted group-hover:text-text-secondary transition-colors">+</span>
            <span class="text-sm text-text-muted group-hover:text-text-secondary transition-colors">Create your own Roadmap</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Skill-based Roadmaps -->
    <section class="py-12">
      <div class="max-w-[1280px] mx-auto px-4">
        <h2 class="text-2xl font-bold text-white mb-8">Skill-based Roadmaps</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {skillRoadmaps.map((roadmap) => (
            <a 
              href={`/${roadmap.slug}`}
              class="group flex items-center gap-3 p-3 rounded-lg bg-bg-secondary border border-border-default hover:border-border-hover transition-all duration-200 hover:-translate-y-0.5"
            >
              <span class="text-lg flex-shrink-0">{roadmap.icon}</span>
              <span class="text-sm font-medium text-white group-hover:text-accent-yellow transition-colors flex-1">{roadmap.title}</span>
              <span class="text-text-muted group-hover:text-text-secondary transition-colors">→</span>
            </a>
          ))}
          <a 
            href="/roadmaps"
            class="group flex items-center justify-center gap-2 p-3 rounded-lg border-2 border-dashed border-border-default hover:border-border-hover transition-all duration-200"
          >
            <span class="text-xl text-text-muted group-hover:text-text-secondary transition-colors">+</span>
            <span class="text-sm text-text-muted group-hover:text-text-secondary transition-colors">Create your own Roadmap</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Project Ideas -->
    <section class="py-12">
      <div class="max-w-[1280px] mx-auto px-4">
        <h2 class="text-2xl font-bold text-white mb-8">Project Ideas</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {projectCards.map((project) => (
            <a 
              href={`/${project.slug}/projects`}
              class="group p-6 rounded-lg bg-bg-secondary border border-border-default hover:border-border-hover transition-all duration-200 hover:-translate-y-0.5"
            >
              <h3 class="text-lg font-semibold text-white group-hover:text-accent-yellow transition-colors mb-2">
                {project.title}
              </h3>
              <p class="text-sm text-text-muted">{project.count} projects</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Best Practices -->
    <section class="py-12">
      <div class="max-w-[1280px] mx-auto px-4">
        <h2 class="text-2xl font-bold text-white mb-8">Best Practices</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          {bestPractices.map((bp) => (
            <a 
              href={`/${bp.slug}`}
              class="group p-4 rounded-lg bg-bg-secondary border border-border-default hover:border-border-hover transition-all duration-200 hover:-translate-y-0.5 text-center"
            >
              <span class="text-sm font-medium text-white group-hover:text-accent-yellow transition-colors">{bp.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Guides Section -->
    <section class="py-12">
      <div class="max-w-[1280px] mx-auto px-4">
        <h2 class="text-2xl font-bold text-white mb-8">Guides</h2>
        <div class="flex gap-3 overflow-x-auto pb-4 scrollbar-thin">
          {guides.map((guide) => (
            <a 
              href={`/guides/${guide.slug}`}
              class="group flex-shrink-0 w-64 p-4 rounded-lg bg-bg-secondary border border-border-default hover:border-border-hover transition-all duration-200"
            >
              <div class="flex items-center gap-2 mb-2">
                {guide.type === 'new' && (
                  <span class="px-2 py-0.5 text-[10px] font-medium bg-green-500/10 text-green-400 border border-green-500/20 rounded-full">New</span>
                )}
                {guide.type === 'textual' && (
                  <span class="px-2 py-0.5 text-[10px] font-medium bg-gray-500/10 text-gray-400 border border-gray-500/20 rounded-full">Textual</span>
                )}
              </div>
              <span class="text-sm font-medium text-white group-hover:text-accent-yellow transition-colors line-clamp-2">{guide.title}</span>
              <span class="text-text-muted text-xs mt-2 block">»</span>
            </a>
          ))}
        </div>
        <a href="/guides" class="inline-flex items-center gap-1 mt-4 text-sm text-accent-yellow hover:text-yellow-300 transition-colors">
          View All Guides →
        </a>
      </div>
    </section>

    <!-- Actively Maintained -->
    <section class="py-12">
      <div class="max-w-[1280px] mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <div>
            <h2 class="text-2xl font-bold text-white mb-4">Actively Maintained</h2>
            <p class="text-text-secondary text-sm leading-relaxed">
              We are constantly improving and updating the roadmaps. You can find the latest updates and changes in the changelog section.
            </p>
          </div>
          <div>
            <div class="space-y-3">
              {changelog.map((entry) => (
                <div class="flex items-start gap-3 p-3 rounded-lg hover:bg-bg-secondary transition-colors">
                  <span class="text-xs text-text-muted whitespace-nowrap mt-0.5 w-24 flex-shrink-0">{entry.date}</span>
                  <div>
                    <span class="text-sm font-medium text-white">{entry.title}</span>
                    <p class="text-xs text-text-muted mt-0.5">{entry.desc}</p>
                  </div>
                </div>
              ))}
            </div>
            <div class="flex items-center gap-4 mt-6">
              <a href="/changelog" class="text-sm text-accent-yellow hover:text-yellow-300 transition-colors">
                View Full Changelog
              </a>
              <a href="/signup" class="text-sm text-text-secondary hover:text-white transition-colors">
                Subscribe for Notifications
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CommunityStats />
  </main>

  <Footer />
</BaseLayout>
