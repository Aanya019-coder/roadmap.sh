---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import CommunityStats from '../components/home/CommunityStats.astro';

const changelog = [
  { date: 'May 28, 2026', title: 'New Claude Code Roadmap', desc: 'Introduced a comprehensive curriculum for developers getting started with Claude Code terminal tools.' },
  { date: 'May 20, 2026', title: 'New Vibe Coding Roadmap', desc: 'Added a guide detailing workflows, prompt styles, and orchestration rules for AI-assisted vibe coding.' },
  { date: 'Apr 28, 2026', title: 'AI Agents Roadmap', desc: 'Step by step guide covering Agentic RAG, tool use, memory systems, and popular agent frameworks.' },
  { date: 'Apr 15, 2026', title: 'LeetCode Roadmap', desc: 'A structured checklist mapping standard algorithmic patterns to LeetCode practice problems.' },
  { date: 'Mar 30, 2026', title: 'Scala Roadmap', desc: 'Released the long-awaited Scala developer learning path detailing compiler features and actors model.' },
  { date: 'Mar 15, 2026', title: 'AI Red Teaming Roadmap', desc: 'Guide on security analysis, jailbreak detection, and vulnerability testing in LLM applications.' },
  { date: 'Feb 28, 2026', title: 'Next.js Roadmap Update', desc: 'Updated the Next.js roadmap to reflect Next.js 16 recommendations and server action guidelines.' },
  { date: 'Feb 10, 2026', title: 'Code Review Best Practices', desc: 'Added checklist for PR templates, review etiquettes, automated checks, and testing guidelines.' },
  { date: 'Jan 20, 2026', title: 'Network Engineer Roadmap', desc: 'Comprehensive guide covering OSI models, subnets, routers, firewalls, and cloud configuration.' },
  { date: 'Jan 05, 2026', title: 'BI Analyst Roadmap', desc: 'Structured path focusing on PowerBI, Tableau, data warehouses, ETL processes, and dashboard designs.' },
  { date: 'Dec 18, 2025', title: 'Interactive Projects Launch', desc: 'Introduced hands-on backend and frontend project ideas with live milestone checkoffs.' },
  { date: 'Dec 01, 2025', title: 'Supabase Auth Integration', desc: 'Enabled secure account creations and database progress syncs across desktop and mobile devices.' },
  { date: 'Nov 14, 2025', title: 'Rust Roadmap Overhaul', desc: 'Expanded Rust learning path to cover asynchronous runtimes (Tokio) and macro systems.' },
  { date: 'Oct 30, 2025', title: 'Prompt Engineering Guide', desc: 'Released guide for prompt structures, few-shot prompting, and chain of thought models.' },
  { date: 'Oct 10, 2025', title: 'Kubernetes Path Update', desc: 'Updated K8s concepts to reflect latest helm charts and service meshes (Istio).' },
  { date: 'Sep 25, 2025', title: 'SQL & Database Design Guide', desc: 'Added checklists mapping normalization levels, indexes, transactions, and performance query tuning.' },
  { date: 'Sep 05, 2025', title: 'React 19 Readiness Roadmap', desc: 'Updated React developer path to cover server components, actions API, and use hooks.' },
  { date: 'Aug 18, 2025', title: 'System Design Interview Checklist', desc: 'Comprehensive list of concepts from load balancers to sharding for architectural interview preps.' },
];
---

<BaseLayout title="Changelog" description="Follow the updates, additions, and new roadmap releases on roadmap.sh.">
  <Navbar client:load />

  <main class="max-w-[700px] mx-auto px-4 py-16">
    <div class="mb-12 text-center">
      <h1 class="text-3xl font-extrabold text-white mb-4">Changelog</h1>
      <p class="text-text-secondary text-sm">
        Stay updated with the latest roadmaps, articles, guides, and site improvements.
      </p>
    </div>

    {/* Timeline */}
    <div class="relative border-l border-border-default pl-6 ml-4 space-y-12">
      {changelog.map((entry) => (
        <div class="relative">
          {/* Node dot */}
          <span class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-bg-primary border-2 border-accent-yellow" />
          
          <div class="space-y-2">
            <span class="text-xs font-semibold text-text-muted">{entry.date}</span>
            <h2 class="text-lg font-bold text-white leading-snug">{entry.title}</h2>
            <p class="text-sm text-text-secondary leading-relaxed">{entry.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </main>

  <CommunityStats />
  <Footer />
</BaseLayout>
