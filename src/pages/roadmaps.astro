---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import CommunityStats from '../components/home/CommunityStats.astro';

const categories = {
  'DevOps': [
    { title: 'DevOps', slug: 'devops' },
    { title: 'DevSecOps', slug: 'devsecops' },
    { title: 'Linux', slug: 'linux' },
    { title: 'Kubernetes', slug: 'kubernetes' },
    { title: 'Docker', slug: 'docker' },
    { title: 'AWS', slug: 'aws' },
    { title: 'Terraform', slug: 'terraform' },
    { title: 'Cloudflare', slug: 'cloudflare' },
    { title: 'Network Engineer', slug: 'network-engineer' },
  ],
  'Web Development': [
    { title: 'Frontend', slug: 'frontend' },
    { title: 'Backend', slug: 'backend' },
    { title: 'Full Stack', slug: 'full-stack' },
    { title: 'QA', slug: 'qa' },
    { title: 'API Design', slug: 'api-design' },
    { title: 'GraphQL', slug: 'graphql' },
    { title: 'Git and GitHub', slug: 'git-github' },
    { title: 'WordPress', slug: 'wordpress' },
  ],
  'Languages / Platforms': [
    { title: 'SQL', slug: 'sql' },
    { title: 'JavaScript', slug: 'javascript' },
    { title: 'TypeScript', slug: 'typescript' },
    { title: 'Node.js', slug: 'nodejs' },
    { title: 'Python', slug: 'python' },
    { title: 'Java', slug: 'java' },
    { title: 'C++', slug: 'cpp' },
    { title: 'Rust', slug: 'rust' },
    { title: 'Go', slug: 'golang' },
    { title: 'PHP', slug: 'php' },
    { title: 'Kotlin', slug: 'kotlin' },
    { title: 'HTML', slug: 'html' },
    { title: 'CSS', slug: 'css' },
    { title: 'Swift & SwiftUI', slug: 'swift' },
    { title: 'Shell/Bash', slug: 'shell' },
    { title: 'Laravel', slug: 'laravel' },
    { title: 'Django', slug: 'django' },
    { title: 'Ruby', slug: 'ruby' },
    { title: 'Ruby on Rails', slug: 'ruby-on-rails' },
    { title: 'Scala', slug: 'scala' },
  ],
  'Databases': [
    { title: 'PostgreSQL', slug: 'postgresql' },
    { title: 'MongoDB', slug: 'mongodb' },
    { title: 'Redis', slug: 'redis' },
    { title: 'Elasticsearch', slug: 'elasticsearch' },
  ],
  'Best Practices': [
    { title: 'AWS', slug: 'aws-best-practices' },
    { title: 'API Security', slug: 'api-security-best-practices' },
    { title: 'Backend Performance', slug: 'backend-performance-best-practices' },
    { title: 'Frontend Performance', slug: 'frontend-performance-best-practices' },
    { title: 'Code Review', slug: 'code-review-best-practices' },
  ],
};
---

<BaseLayout title="Developer Roadmaps" description="Browse the ever-growing list of up-to-date, community driven roadmaps">
  <Navbar client:load />

  <main class="py-12">
    <div class="max-w-[1280px] mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Developer Roadmaps</h1>
        <p class="text-text-secondary text-base max-w-2xl mx-auto mb-6">
          Browse the ever-growing list of up-to-date, community driven roadmaps
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a 
            href="https://github.com/kamranahmedse/developer-roadmap" 
            target="_blank"
            class="px-4 py-2 border border-border-default text-white text-sm font-medium rounded-md hover:border-border-hover hover:bg-bg-tertiary transition-all"
          >
            Draw your own roadmap
          </a>
          <button 
            class="px-4 py-2 bg-accent-yellow text-gray-900 text-sm font-medium rounded-md opacity-75 cursor-not-allowed"
            title="AI features coming soon"
            disabled
          >
            Generate Roadmaps with AI
          </button>
        </div>
      </div>

      <!-- Categories -->
      <div class="space-y-10">
        <p class="text-xs font-semibold text-text-muted uppercase tracking-widest">Categories</p>
        
        {Object.entries(categories).map(([category, links]) => (
          <div>
            <h2 class="text-lg font-semibold text-white mb-4 pb-2 border-b border-border-default">{category}</h2>
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              {links.map((link) => (
                <a 
                  href={`/${link.slug}`}
                  class="text-sm text-text-secondary hover:text-accent-yellow transition-colors py-1"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <CommunityStats />
  <Footer />
</BaseLayout>
