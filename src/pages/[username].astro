---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import Avatar from '../components/ui/Avatar';
import Badge from '../components/ui/Badge';
import Card from '../components/ui/Card';
import ProgressBar from '../components/ui/ProgressBar';

export async function getStaticPaths() {
  return [
    { params: { username: 'guest' } },
    { params: { username: 'developer-one' } },
  ];
}

const { username } = Astro.params;

const userProfile = {
  username: username,
  name: username === 'developer-one' ? 'Alex Coder' : 'Guest Developer',
  bio: username === 'developer-one' 
    ? 'Frontend specialist learning backend systems. Love building open-source projects.'
    : 'New to roadmap.sh! Learning something new every day.',
  avatarUrl: undefined,
  roadmaps: [
    { title: 'Frontend Developer', slug: 'frontend', progress: 65 },
    { title: 'React', slug: 'react', progress: 40 },
    { title: 'SQL', slug: 'sql', progress: 100 },
  ],
  projects: [
    { title: 'Personal Portfolio', slug: 'portfolio', status: 'submitted', difficulty: 'beginner' },
    { title: 'E-commerce API', slug: 'ecommerce-api', status: 'started', difficulty: 'intermediate' },
  ],
};
---

<BaseLayout title={`${userProfile.name} (@${userProfile.username})`} description={`Check out ${userProfile.name}'s learning progress and completed projects on roadmap.sh.`}>
  <Navbar client:load />

  <main class="max-w-[1000px] mx-auto px-4 py-12">
    {/* Profile Card */}
    <div class="bg-bg-secondary border border-border-default rounded-xl p-8 mb-8 flex flex-col md:flex-row items-center md:items-start gap-6">
      <Avatar size="xl" name={userProfile.name} className="flex-shrink-0" />
      <div class="flex-1 text-center md:text-left">
        <div class="flex flex-col md:flex-row md:items-center gap-3 mb-2 justify-center md:justify-start">
          <h1 class="text-2xl font-bold text-white">{userProfile.name}</h1>
          <Badge variant="tech">@{userProfile.username}</Badge>
        </div>
        <p class="text-sm text-text-secondary mb-4 max-w-xl">{userProfile.bio}</p>
        <div class="flex items-center justify-center md:justify-start gap-4 text-xs text-text-muted">
          <span>Joined June 2026</span>
          <span>•</span>
          <span>{userProfile.roadmaps.filter(r => r.progress === 100).length} completed</span>
        </div>
      </div>
      <div class="flex-shrink-0">
        <a 
          href="/account/settings"
          class="px-4 py-2 border border-border-default text-text-secondary text-sm rounded-md hover:border-border-hover hover:text-white transition-all font-medium inline-block"
        >
          Edit Profile
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {/* Left 2 cols: Activity & Progress */}
      <div class="md:col-span-2 space-y-8">
        {/* Roadmaps */}
        <section class="bg-bg-secondary border border-border-default rounded-xl p-6">
          <h2 class="text-lg font-bold text-white mb-6">Roadmaps</h2>
          <div class="space-y-6">
            {userProfile.roadmaps.map((roadmap) => (
              <div class="border border-border-default/40 rounded-lg p-4 bg-bg-primary/20">
                <div class="flex items-center justify-between mb-3">
                  <a href={`/${roadmap.slug}`} class="text-sm font-semibold text-white hover:text-accent-yellow transition-colors">
                    {roadmap.title}
                  </a>
                  <span class="text-xs font-semibold text-text-secondary">{roadmap.progress}% Completed</span>
                </div>
                <ProgressBar percentage={roadmap.progress} showLabel={false} color={roadmap.progress === 100 ? 'green' : 'yellow'} />
              </div>
            ))}
          </div>
        </section>
      </div>

      {/* Right col: Projects */}
      <div class="space-y-8">
        <section class="bg-bg-secondary border border-border-default rounded-xl p-6">
          <h2 class="text-lg font-bold text-white mb-6">Project Progress</h2>
          <div class="space-y-4">
            {userProfile.projects.map((project) => (
              <div class="border border-border-default/40 rounded-lg p-4 bg-bg-primary/20">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold text-text-muted uppercase tracking-wider">{project.difficulty}</span>
                  <Badge variant={project.status === 'submitted' ? 'beginner' : 'intermediate'}>
                    {project.status === 'submitted' ? 'Submitted' : 'Started'}
                  </Badge>
                </div>
                <h3 class="text-sm font-semibold text-white mb-3">{project.title}</h3>
                <a 
                  href={`/projects/${project.slug}`}
                  class="text-xs text-accent-yellow hover:underline flex items-center gap-1"
                >
                  View Details →
                </a>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
