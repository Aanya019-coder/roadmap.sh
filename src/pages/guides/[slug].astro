---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge';
import CommunityStats from '../../components/home/CommunityStats.astro';

export async function getStaticPaths() {
  const guides = await Astro.glob('../../data/guides/*.md');
  return guides.map(guide => {
    const slug = guide.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { guide }
    };
  });
}

const { guide } = Astro.props;
const Content = guide.Content;
const headings = guide.getHeadings();
---

<BaseLayout title={guide.frontmatter.title} description={guide.frontmatter.description}>
  <Navbar client:load />

  <main class="max-w-[1280px] mx-auto px-4 py-12">
    {/* Breadcrumbs */}
    <div class="mb-6">
      <a href="/guides" class="text-xs text-text-muted hover:text-text-secondary transition-colors">
        ← All Guides
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
      {/* Article Content */}
      <div class="lg:col-span-3 space-y-8">
        <header class="border-b border-border-default pb-8 mb-8">
          <div class="flex items-center gap-3 mb-4">
            <Badge variant={guide.frontmatter.type === 'new' ? 'new' : 'textual'}>
              {guide.frontmatter.type}
            </Badge>
            <span class="text-xs text-text-muted">{guide.frontmatter.date}</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4 leading-tight">
            {guide.frontmatter.title}
          </h1>
          <p class="text-base text-text-secondary leading-relaxed">
            {guide.frontmatter.description}
          </p>
        </header>

        <article class="prose max-w-none text-text-secondary">
          <Content />
        </article>
      </div>

      {/* Sticky Table of Contents Sidebar */}
      <div class="hidden lg:block">
        <div class="sticky top-20 border border-border-default bg-bg-secondary/40 rounded-xl p-6">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-4">On this page</h3>
          <nav class="space-y-2.5">
            {headings.filter(h => h.depth <= 3).map((h) => (
              <a 
                href={`#${h.slug}`}
                class={`block text-xs text-text-secondary hover:text-white transition-colors leading-relaxed ${
                  h.depth === 3 ? 'pl-4 border-l border-border-default/40' : 'font-medium'
                }`}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </main>

  <CommunityStats />
  <Footer />
</BaseLayout>
