  <div class="max-w-[1280px] mx-auto px-4 py-12">
    <!-- Links Row -->
    <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-text-secondary mb-6">
      <a href="/roadmaps" class="hover:text-white transition-colors">Roadmaps</a>
      <span class="text-text-muted">·</span>
      <a href="/guides" class="hover:text-white transition-colors">Guides</a>
      <span class="text-text-muted">·</span>
