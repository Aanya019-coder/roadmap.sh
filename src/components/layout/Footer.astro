    <!-- Attribution -->
    <p class="text-center text-sm text-text-secondary mb-4">
      roadmap.sh by <a href="https://twitter.com/nilbuild" target="_blank" rel="noopener" class="text-accent-yellow hover:text-yellow-300 transition-colors">@nilbuild</a>
