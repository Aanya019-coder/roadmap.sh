<section class="py-16 border-t border-border-default">
  <div class="max-w-[1280px] mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <!-- GitHub Stars -->
      <div>
        <div class="text-3xl font-bold text-white mb-1">356K</div>
        <div class="text-sm text-text-secondary mb-1">GitHub Stars</div>
        <div class="text-xs text-text-muted mb-3">+90k every month</div>
        <a 
          href="https://github.com/kamranahmedse/developer-roadmap" 
          target="_blank" 
          rel="noopener"
          class="text-sm text-accent-yellow hover:text-yellow-300 transition-colors"
        >
          Star us on GitHub →
        </a>
      </div>

      <!-- Registered Users -->
      <div>
        <div class="text-3xl font-bold text-white mb-1">+2.8M</div>
        <div class="text-sm text-text-secondary mb-1">Registered Users</div>
        <div class="text-xs text-text-muted mb-3">+2k every month</div>
        <a 
          href="/signup"
          class="text-sm text-accent-yellow hover:text-yellow-300 transition-colors"
        >
          Register yourself →
        </a>
      </div>

      <!-- Discord Members -->
      <div>
        <div class="text-3xl font-bold text-white mb-1">48K</div>
        <div class="text-sm text-text-secondary mb-1">Discord Members</div>
        <div class="text-xs text-text-muted mb-3">&nbsp;</div>
        <a 
          href="https://discord.gg/roadmapsh" 
          target="_blank" 
          rel="noopener"
          class="text-sm text-accent-yellow hover:text-yellow-300 transition-colors"
        >
          Join on Discord →
        </a>
      </div>
    </div>
  </div>
</section>
