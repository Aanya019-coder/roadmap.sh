---
import Layout from '../layouts/Layout.astro';
import RoadmapCard from '../components/roadmap/RoadmapCard';
import { api } from '../lib/api';

const stats = [
  { value: '350K+',  label: 'GitHub Stars'     },
  { value: '2.8M+',  label: 'Monthly Users'    },
  { value: '45K+',   label: 'AI Roadmaps'      },
  { value: '1,100+', label: 'Learning Paths'   },
];

// Fetch some roadmaps for the landing page
let roadmaps: any[] = [];
try {
  const resp = await api.getRoadmaps();
  if (resp.success) roadmaps = resp.data;
} catch (e) {}

const featuredRoadmaps = roadmaps.slice(0, 6);
---

<Layout title="Your Personalized Developer Path" description="AI-powered developer roadmaps tailored to your unique goals and background.">

  <!-- ══════════════════════════════════════
       HERO (Glass Focused)
       ══════════════════════════════════════ -->
  <section style="padding: 9rem 0 7rem; position: relative; overflow: hidden; background: radial-gradient(circle at 50% -20%, rgba(59, 130, 246, 0.15), transparent 60%);">

    <!-- Decorative Elements -->
    <div style="position:absolute; top: 10%; left: -5%; width: 400px; height: 400px; background: rgba(59, 130, 246, 0.05); filter: blur(100px); border-radius: 50%;"></div>
    <div style="position:absolute; bottom: 0%; right: -5%; width: 500px; height: 500px; background: rgba(16, 185, 129, 0.03); filter: blur(120px); border-radius: 50%;"></div>

    <div class="container reveal" style="text-align:center; position:relative; z-index:10;">
      <!-- Premium Badge -->
      <div style="display:inline-flex; align-items:center; gap:0.625rem; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border-radius: 999px; padding: 0.5rem 1.25rem; margin-bottom: 2.5rem; font-size: 0.8125rem; font-weight: 600; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">
        <span style="color: var(--color-accent);">✨</span>
        The Future of Developer Education
      </div>

      <h1 style="font-size: clamp(3rem, 10vw, 5.5rem); line-height: 0.95; margin-bottom: 1.75rem; max-width: 1000px; margin-inline: auto;">
        Master your path<br/>
        <span style="background: linear-gradient(to right, #60a5fa, #34d399); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">with AI precision.</span>
      </h1>

      <p style="font-size: clamp(1.125rem, 3vw, 1.35rem); max-width: 680px; margin: 0 auto 3.5rem; color: var(--color-text-secondary); font-weight: 400; line-height: 1.6;">
        Generic roadmaps are dead. Get a dynamic, AI-personalized learning path that adapts to your background, schedule, and dream career.
      </p>

      <div style="display:flex; gap:1.25rem; justify-content:center; flex-wrap:wrap; margin-bottom:6rem;">
        <a href="/onboarding" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.0625rem; border-radius: 14px;">
           Build My Roadmap
        </a>
        <a href="/roadmaps" class="btn btn-secondary" style="padding: 1rem 2.5rem; font-size: 1.0625rem; border-radius: 14px; backdrop-filter: blur(10px);">
          Explore All Paths
        </a>
      </div>

      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 4rem; max-width: 900px; margin-inline: auto; opacity: 0.7;">
        {stats.map(s => (
          <div>
            <div style="font-size: 2.25rem; font-weight: 800; color: #fff; letter-spacing: -0.02em;">{s.value}</div>
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.5rem;">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       FEATURES (Glass Cards)
       ══════════════════════════════════════ -->
  <section style="padding: 8rem 0; background: #080808;">
    <div class="container">
      <div style="text-align:center; margin-bottom: 5rem;">
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">Why roadmap.sh AI?</h2>
        <p style="max-width: 500px; margin: 0 auto;">Designed for the modern solo developer.</p>
      </div>

      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem;">
        <div class="roadmap-card" style="padding: 3rem;">
          <div style="font-size: 2.5rem; margin-bottom: 1.5rem;">🎯</div>
          <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Precision Learning</h3>
          <p>We analyze your current skill set to skip what you already know and focus only on the gaps that matter for your goals.</p>
        </div>
        <div class="roadmap-card" style="padding: 3rem;">
          <div style="font-size: 2.5rem; margin-bottom: 1.5rem;">⏱️</div>
          <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Time Optimized</h3>
          <p>Only have 5 hours a week? Our AI re-calculates your path to ensure you hit your milestones without burning out.</p>
        </div>
        <div class="roadmap-card" style="padding: 3rem;">
          <div style="font-size: 2.5rem; margin-bottom: 1.5rem;">🤖</div>
          <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">AI Tutor On-Demand</h3>
          <p>Stuck on a concept? Your personalized AI tutor has the context of your entire roadmap and can clear doubts instantly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       ROADMAP HIGHLIGHTS
       ══════════════════════════════════════ -->
  <section style="padding: 8rem 0;">
    <div class="container">
      <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; margin-bottom: 3.5rem; flex-wrap:wrap;">
        <div>
          <h2 style="font-size: 2.25rem;">Explore Popular Paths</h2>
          <p>Join millions of developers following these community-vetted roadmaps.</p>
        </div>
        <a href="/roadmaps" class="btn btn-ghost" style="color: var(--color-accent); font-weight: 700;">View All 10+ Roadmaps →</a>
      </div>

      <div class="grid-roadmaps">
        {featuredRoadmaps.map(rm => (
          <RoadmapCard roadmap={rm} client:visible />
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CTA (Final)
       ══════════════════════════════════════ -->
  <section style="padding: 10rem 0;">
    <div class="container">
      <div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%); border: 1px solid rgba(255,255,255,0.1); border-radius: 32px; padding: 6rem 2rem; text-align: center; position: relative; overflow: hidden;">
        <div style="position:absolute; top: -50%; left: -20%; width: 100%; height: 200%; background: radial-gradient(circle, rgba(59, 130, 246, 0.05), transparent 70%); pointer-events:none;"></div>
        
        <h2 style="font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1.5rem;">Ready to start your journey?</h2>
        <p style="max-width: 500px; margin: 0 auto 3rem; font-size: 1.125rem;">Join thousands of individuals carving their own path in tech.</p>
        
        <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
          <a href="/signup" class="btn btn-primary btn-lg" style="border-radius:14px; padding-inline: 3rem;">Sign Up Free</a>
          <a href="/roadmaps" class="btn btn-secondary btn-lg" style="border-radius:14px; padding-inline: 3rem;">Browse Roadmaps</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
