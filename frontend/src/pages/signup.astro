---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Create Account" description="Sign up for roadmap.sh and get your personalized developer roadmap">
  <div id="signup-root" class="min-h-screen flex items-center justify-center p-4" style="background:var(--color-bg-primary)">
  </div>
  <script>
    import { mountSignupPage } from '../components/auth/SignupPage';
    mountSignupPage(document.getElementById('signup-root')!);
  </script>
</Layout>
