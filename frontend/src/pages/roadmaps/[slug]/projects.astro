---
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;

let roadmap: any = null;
let projects: any[] = [];
try {
  const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:5000';
  const [rmRes, projRes] = await Promise.all([
    fetch(`${backendUrl}/api/roadmaps/${slug}`),
    fetch(`${backendUrl}/api/roadmaps/${slug}/projects`),
  ]);
  const rmJson = await rmRes.json();
  const projJson = await projRes.json();
  if (rmJson.success) roadmap = rmJson.data;
  if (projJson.success) projects = projJson.data;
} catch (e) {}

if (!roadmap) return Astro.redirect('/roadmaps');

const difficultyColor: Record<string, string> = {
  beginner: 'badge-green',
  intermediate: 'badge-yellow',
  advanced: 'badge-gray',
};
---

<Layout title={`${roadmap.title} Projects`} description={`Hands-on project ideas for the ${roadmap.title} roadmap`}>
  <div class="container" style="padding-top:3rem;padding-bottom:4rem">
    <nav style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:1.5rem">
      <a href="/" style="color:inherit">Home</a> /
      <a href="/roadmaps" style="color:inherit"> Roadmaps</a> /
      <a href={`/roadmaps/${slug}`} style="color:inherit"> {roadmap.title}</a> /
      <span style="color:var(--color-text-secondary)"> Projects</span>
    </nav>

    <div style="margin-bottom:2.5rem">
      <h1 style="font-size:2rem;font-weight:800;color:var(--color-text-primary);margin-bottom:0.75rem">
        {roadmap.icon} Project Ideas — {roadmap.title}
      </h1>
      <p style="color:var(--color-text-secondary);font-size:1rem;line-height:1.6;max-width:600px">
        The best way to learn is to build. Here are {projects.length} hands-on project ideas that match this roadmap's skills — from beginner-friendly to advanced.
      </p>
    </div>

    {projects.length === 0 && (
      <div style="text-align:center;padding:4rem 2rem;color:var(--color-text-muted)">
        <div style="font-size:2.5rem;margin-bottom:1rem">🔨</div>
        <p>No projects listed yet. Check back soon!</p>
      </div>
    )}

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.25rem">
      {projects.map((project: any) => (
        <div class="card" style="display:flex;flex-direction:column;gap:0.75rem">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem">
            <h3 style="font-size:1.0625rem;font-weight:700;color:var(--color-text-primary);line-height:1.3">{project.title}</h3>
            <span class={`badge ${difficultyColor[project.difficulty] || 'badge-gray'}`} style="flex-shrink:0;text-transform:capitalize">{project.difficulty}</span>
          </div>
          <p style="color:var(--color-text-secondary);font-size:0.9rem;line-height:1.6;flex:1">{project.description}</p>
          {project.tags && project.tags.length > 0 && (
            <div style="display:flex;gap:0.375rem;flex-wrap:wrap">
              {project.tags.map((tag: string) => (
                <span class="badge badge-gray" style="font-size:0.7rem">{tag}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <div style="margin-top:3rem;text-align:center">
      <a href={`/roadmaps/${slug}`} class="btn btn-primary" style="text-decoration:none">
        ← Back to {roadmap.title} Roadmap
      </a>
    </div>
  </div>
</Layout>
