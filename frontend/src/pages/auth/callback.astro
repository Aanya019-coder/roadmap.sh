---
// /auth/callback — Supabase redirects here after OAuth
---
<html>
  <head><title>Redirecting...</title></head>
  <body>
    <script>
      import { supabase } from '../../lib/supabase';

      async function handleCallback() {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          // Check if onboarding completed
          const resp = await fetch('/api/onboarding/answers', {
            headers: { Authorization: `Bearer ${session.access_token}` }
          });
          // Even if it fails we redirect to onboarding
          try {
            const json = await resp.json();
            if (json?.data?.completed_at) {
              window.location.href = '/dashboard';
              return;
            }
          } catch {}
          window.location.href = '/onboarding';
        } else {
          window.location.href = '/login';
        }
      }

      handleCallback();
    </script>
    <p style="font-family:sans-serif;text-align:center;margin-top:4rem;color:#888">Signing you in...</p>
  </body>
</html>
