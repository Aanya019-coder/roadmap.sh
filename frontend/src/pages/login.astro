---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Login" description="Sign in to your roadmap.sh account">
  <div id="login-root" class="min-h-screen flex items-center justify-center p-4" style="background:var(--color-bg-primary)">
  </div>
  <script>
    import { mountLoginPage } from '../components/auth/LoginPage';
    mountLoginPage(document.getElementById('login-root')!);
  </script>
</Layout>
